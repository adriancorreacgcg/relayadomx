<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:text="Sin modo" />

        <EditText
            android:id="@+id/claveText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Clave del túnel"
            android:inputType="text"
            android:maxLength="12"
            android:textSize="14sp" />

        <Button
            android:id="@+id/modoPagarButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MODO PAGAR (va al cajero)" />

        <Button
            android:id="@+id/modoTarjetaButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MODO TARJETA (tiene la tarjeta)" />

        <EditText
            android:id="@+id/panText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="PAN 16 dígitos"
            android:inputType="number"
            android:maxLength="16"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/vencText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Vencimiento AAMM"
            android:inputType="number"
            android:maxLength="4"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/servicioText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Servicio"
            android:inputType="number"
            android:maxLength="3"
            android:text="201"
            android:textSize="14sp" />

        <Button
            android:id="@+id/connectButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Conectar / Desconectar USB" />

        <Button
            android:id="@+id/aprenderButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aprender tarjeta (USB)" />

        <Button
            android:id="@+id/subirAtcButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Subir ATC 1000 (USB)" />

        <Button
            android:id="@+id/relayButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Relay USB local" />

        <Button
            android:id="@+id/estaticoButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modo 1 estático" />

        <Button
            android:id="@+id/estatico2Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modo 2 banda AIP 19 80" />

        <Button
            android:id="@+id/estatico3Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modo 3 banda AIP 18 00" />

        <Button
            android:id="@+id/estatico4Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modo 4 TC offline + ATC" />

        <Button
            android:id="@+id/estatico5Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modo 5 ARQC + ATC" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detener" />

        <Button
            android:id="@+id/firmwareButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Capturar tarjeta" />

        <Button
            android:id="@+id/volcarButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ver guardado" />

        <Button
            android:id="@+id/clearButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Limpiar registro" />

        <TextView
            android:id="@+id/cardInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textIsSelectable="true" />

    </LinearLayout>
</ScrollView>