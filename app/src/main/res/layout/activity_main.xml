<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1B2B"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="RelayadoMx"
            android:textColor="#E6EDF3"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="logo"
            android:src="@drawable/logo" />
    </LinearLayout>

    <EditText
        android:id="@+id/claveText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="clave"
        android:inputType="text"
        android:text="m4xq9vt2r7kdp3wz"
        android:textColor="#E6EDF3"
        android:textColorHint="#5B7083"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/modoPagarButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:backgroundTint="#1B3A57"
            android:text="MODO PAGAR"
            android:textColor="#E6EDF3"
            android:textSize="15sp" />

        <Button
            android:id="@+id/modoTarjetaButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="#1B3A57"
            android:text="MODO TARJETA"
            android:textColor="#E6EDF3"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="#13293D"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/modoEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modo: ninguno"
            android:textColor="#E6EDF3"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/brokerEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Broker: apagado"
            android:textColor="#E6EDF3"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/enlaceEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enlace: —"
            android:textColor="#E6EDF3"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tarjetaEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tarjeta: —"
            android:textColor="#E6EDF3"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tarjetaDatos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#4C9AFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Transacción: esperando"
            android:textColor="#E6EDF3"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/apduButton"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="#13293D"
        android:text="MOSTRAR TRANSACCIÓN APDU"
        android:textColor="#8FB8DE"
        android:textSize="12sp" />

    <ScrollView
        android:id="@+id/scrollLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:background="#08131F"
        android:visibility="gone">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:padding="6dp"
            android:textColor="#9FB3C8"
            android:textSize="10sp" />
    </ScrollView>

    <!-- ===== oculto ===== -->

    <Button
        android:id="@+id/connectButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="Conectar USB" />

    <Button
        android:id="@+id/relayButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="Relay" />

    <Button
        android:id="@+id/aprenderButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="Aprender" />

    <Button
        android:id="@+id/subirAtcButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="Subir ATC 1000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button android:id="@+id/estaticoButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="M1" />
        <Button android:id="@+id/estatico2Button" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="M2" />
        <Button android:id="@+id/estatico3Button" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="M3" />
        <Button android:id="@+id/estatico4Button" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="M4" />
        <Button android:id="@+id/estatico5Button" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="M5" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button android:id="@+id/firmwareButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="Firmware" />
        <Button android:id="@+id/volcarButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="Ver guardado" />
        <Button android:id="@+id/stopButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="Detener" />
        <Button android:id="@+id/clearButton" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1" android:text="Limpiar" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <EditText android:id="@+id/panText" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="3"
            android:hint="PAN" android:inputType="number" />
        <EditText android:id="@+id/vencText" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:hint="MMAA" android:inputType="number" />
        <EditText android:id="@+id/servicioText" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:hint="201" android:inputType="number" />
    </LinearLayout>

    <TextView
        android:id="@+id/cardInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone" />

</LinearLayout>